# === Force HTTPS redirect ===
RewriteEngine On
# Only redirect if HTTPS is off (prevents loops)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^(www\.)?peopleintelligence\.co\.za$ [NC]
RewriteRule ^(.*)$ https://www.peopleintelligence.co.za/$1 [R=301,L]

# === Pre-rendered pages ===
# Drop trailing slash on page URLs (/christian-coaching/ -> /christian-coaching)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/.]+)/$ /$1 [R=301,L]

# /christian-coaching -> christian-coaching.html (clean URL, no redirect)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/.]+)/?$ /$1.html [L]

# Hide the .html versions so each page has only one URL
RewriteCond %{THE_REQUEST} \s/([^/.]+)\.html[\s?]
RewriteCond %1 !^(index|404)$
RewriteRule ^ /%1 [R=301,L]

# Unknown URLs get a real 404 (previously they returned the homepage)
ErrorDocument 404 /404.html

# === Security headers ===
<IfModule mod_headers.c>
    # HSTS: browsers use HTTPS for this host for a year.
    # includeSubDomains/preload removed until every subdomain is confirmed to work
    # over HTTPS (preload is hard to undo). See the deploy notes before re-adding.
    Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS

    # Content Security Policy (CSP) - tightened for security
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; font-src 'self'; img-src 'self' https:; connect-src 'self' https://cloudflareinsights.com; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; media-src 'self'; form-action 'self'; upgrade-insecure-requests;"

    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Legacy XSS filter is obsolete and can introduce bugs: explicitly disable it
    Header always set X-XSS-Protection "0"

    # Referrer policy for privacy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions policy (disable unused features)
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # HTML: always check for a fresh copy, so visitors never get an old page that
    # points at asset files which no longer exist after a deploy
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>

    # Files in /assets have a content hash in their name and never change:
    # cache them for a year
    <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|webp|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# === Cache static files for performance ===
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 week"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# === Gzip compression for performance ===
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>
